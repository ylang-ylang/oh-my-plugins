{
  "name": "oh-my-plugins",
  "version": "0.5.5",
  "private": true,
  "type": "module",
  "description": "OMP and Pi plugin collection: LAN RPC and BTW",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ylang-ylang/oh-my-plugins.git"
  },
  "homepage": "https://github.com/ylang-ylang/oh-my-plugins",
  "bugs": {
    "url": "https://github.com/ylang-ylang/oh-my-plugins/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "plugins/*"
  ],
  "omp": {
    "extensions": [
      "./plugins/lanrpc/extension.mjs"
    ]
  },
  "pi": {
    "extensions": [
      "./plugins/lanrpc/extension.mjs",
      "./plugins/btw/extension.ts"
    ]
  },
  "files": [
    "plugins/*",
    "!plugins/**/*.test.mjs",
    "!plugins/**/test-support.mjs"
  ],
  "scripts": {
    "test": "npm run test --workspaces",
    "test:lanrpc": "npm run test --workspace @ylang/lanrpc",
    "test:btw": "npm run test --workspace @ylang/pi-btw",
    "test:compat": "node compat/docker.mjs --all",
    "compat:list": "node compat/docker.mjs --list",
    "plugins:check": "node scripts/plugins.mjs check",
    "plugins:publish": "node scripts/plugins.mjs publish"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
