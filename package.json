{
  "name": "omp-lan-rpc",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Authenticated local and LAN message access to a running OMP session",
  "repository": { "type": "git", "url": "git+https://github.com/ylang-ylang/omp-lan-rpc.git" },
  "homepage": "https://github.com/ylang-ylang/omp-lan-rpc",
